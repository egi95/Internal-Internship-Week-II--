// task2.dart
// Programi që ndan numrat në çift dhe tek

// Funksioni që kthen një hartë me dy lista: 'cift' dhe 'tek'
Map<String, List<int>> ndaj(List<int> nums) {
  List<int> cift = [];
  List<int> tek = [];

  for (int n in nums) {
    if (n % 2 == 0) {
      cift.add(n);
    } else {
      tek.add(n);
    }
  }

  return {
    'cift': cift,
    'tek': tek,
  };
}

void main() {
  // Shembull testimi me një listë të zakonshme
  List<int> numrat = [1, 2, 3, 4, 5, 6];
  Map<String, List<int>> rezultat = ndaj(numrat);

  print("Numrat çift: ${rezultat['cift']}");
  print("Numrat tek: ${rezultat['tek']}");

  // Testim me listë bosh
  List<int> bosh = [];
  var rezultatBosh = ndaj(bosh);
  print("\nTest me listë bosh:");
  print("Numrat çift: ${rezultatBosh['cift']}");
  print("Numrat tek: ${rezultatBosh['tek']}");

  // Testim me vetëm numra tek
  List<int> vetemTek = [1, 3, 5, 7];
  var rezultatTek = ndaj(vetemTek);
  print("\nVetëm tek:");
  print("Numrat çift: ${rezultatTek['cift']}");
  print("Numrat tek: ${rezultatTek['tek']}");

  // Testim me vetëm numra çift
  List<int> vetemCift = [2, 4, 6, 8];
  var rezultatCift = ndaj(vetemCift);
  print("\nVetëm çift:");
  print("Numrat çift: ${rezultatCift['cift']}");
  print("Numrat tek: ${rezultatCift['tek']}");
}

Output
Numrat çift: [2, 4, 6]
Numrat tek: [1, 3, 5]

Test me listë bosh:
Numrat çift: []
Numrat tek: []

Vetëm tek:
Numrat çift: []
Numrat tek: [1, 3, 5, 7]

Vetëm çift:
Numrat çift: [2, 4, 6, 8]
Numrat tek: []
