Map<String, List<int>> ndaj(List<int> nums) {
  List<int> cift = [];
  List<int> tek = [];
  for (var n in nums) {
    if (n % 2 == 0) {
      cift.add(n);
    } else {
      tek.add(n);
    }
  }
  return {'cift': cift, 'tek': tek};
}

void main() {
  List<int> lista = [1, 2, 3, 4, 5, 6];
  Map<String, List<int>> rezultat = ndaj(lista);
  print('cift: ${rezultat['cift']}');
  print('tek: ${rezultat['tek']}');
}
