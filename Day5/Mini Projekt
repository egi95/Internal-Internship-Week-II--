home.dart

import 'package:flutter/material.dart';
import 'models/product.dart';

class HomePage extends StatefulWidget {
  static List<Product> products = [];

  @override
  State<HomePage> createState() => _HomePageState();
}

class _HomePageState extends State<HomePage> {
  void _removeItem(int index) {
    setState(() {
      HomePage.products.removeAt(index);
    });
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(content: Text('Produkti u fshi')),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: Text('Lista e Produkteve'),
        actions: [
          IconButton(
            icon: Icon(Icons.info_outline),
            onPressed: () => Navigator.pushNamed(context, '/info'),
          ),
        ],
      ),
      body: HomePage.products.isEmpty
          ? Center(child: Text('Asnje produkt ende.'))
          : ListView.builder(
              itemCount: HomePage.products.length,
              itemBuilder: (context, index) {
                final p = HomePage.products[index];
                return ListTile(
                  title: Text(p.name),
                  subtitle: Text('${p.price.toStringAsFixed(2)} €'),
                  trailing: IconButton(
                    icon: Icon(Icons.delete, color: Colors.red),
                    onPressed: () => _removeItem(index),
                  ),
                );
              },
            ),
      floatingActionButton: FloatingActionButton(
        onPressed: () => Navigator.pushNamed(context, '/add').then((_) {
          setState(() {}); // rifreskon pas kthimit nga AddPage
        }),
        child: Icon(Icons.add),
      ),
    );
  }
}

add_page.dart

import 'package:flutter/material.dart';
import 'home.dart';
import 'models/product.dart';

class AddPage extends StatefulWidget {
  @override
  State<AddPage> createState() => _AddPageState();
}

class _AddPageState extends State<AddPage> {
  final _nameController = TextEditingController();
  final _priceController = TextEditingController();

  void _addProduct() {
    final name = _nameController.text.trim();
    final price = double.tryParse(_priceController.text) ?? 0;

    if (name.isEmpty || price <= 0) {
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('Ju lutem plotesoni te dhenat sakte.')),
      );
      return;
    }

    HomePage.products.add(Product(name, price));
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(content: Text('Produkti u shtua me sukses!')),
    );

    Navigator.pop(context);
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: Text('Shto Produkt')),
      body: Padding(
        padding: const EdgeInsets.all(16.0),
        child: Column(
          children: [
            TextField(
              controller: _nameController,
              decoration: InputDecoration(labelText: 'Emri i produktit'),
            ),
            TextField(
              controller: _priceController,
              keyboardType: TextInputType.number,
              decoration: InputDecoration(labelText: 'Çmimi (€)'),
            ),
            SizedBox(height: 20),
            ElevatedButton(
              onPressed: _addProduct,
              child: Text('Shto'),
            ),
          ],
        ),
      ),
    );
  }
}

