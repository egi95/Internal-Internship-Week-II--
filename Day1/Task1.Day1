// task1.dart
// Programi që llogarit mesataren e notave

import 'dart:io';

// Funksioni që kthen mesataren e një liste notash
double mesatarja(List<double> nota) {
  if (nota.isEmpty) return 0.0;

  double shuma = 0.0;
  for (double n in nota) {
    shuma += n;
  }
  return shuma / nota.length;
}

void main() {
  // Shembull inputi i paracaktuar
  List<double> nota = [7, 8.5, 10, 6];

  double rez = mesatarja(nota);
  print("Mesatarja: ${rez.toStringAsFixed(2)}");

  // Testim shtesë me lista bosh
  List<double> bosh = [];
  double rez2 = mesatarja(bosh);
  print("Mesatarja (lista bosh): ${rez2.toStringAsFixed(2)}");
}

Output
Mesatarja: 7.88
Mesatarja (lista bosh): 0.00
