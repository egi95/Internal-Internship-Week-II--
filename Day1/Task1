// Funksioni që llogarit mesataren e notave
double mesatarja(List<double> nota) {
  if (nota.isEmpty) {
    return 0.0; // Nëse lista është bosh, kthe 0.0
  }

  double shuma = 0.0;
  for (var n in nota) {
    shuma += n;
  }

  return shuma / nota.length; // Llogarit mesataren
}

void main() {
  // Shembuj testimi
  List<double> lista1 = [7, 8.5, 10, 6];
  List<double> lista2 = [];
  List<double> lista3 = [5.5, 9.25, 7.75];

  // Llogarit dhe printo rezultatin me 2 shifra pas presjes
  print("Mesatarja (lista1): ${mesatarja(lista1).toStringAsFixed(2)}");
  print("Mesatarja (lista2): ${mesatarja(lista2).toStringAsFixed(2)}");
  print("Mesatarja (lista3): ${mesatarja(lista3).toStringAsFixed(2)}");
}
