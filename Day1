// Funksioni qe llogarit mesataren e notave
double mesatarja(List<double> nota) {
  if (nota.isEmpty) {
    return 0.0;
  }
  double shuma = 0.0;
  for (var n in nota) {
    shuma += n;
  }
  return shuma / nota.length;
}

void main() {
  // Shembuj testimi
  List<double> nota1 = [7, 8.5, 10, 6];
  List<double> nota2 = [];
  List<double> nota3 = [9.2, 7.8, 8.4];

  double mes1 = mesatarja(nota1);
  double mes2 = mesatarja(nota2);
  double mes3 = mesatarja(nota3);

  print("Mesatarja e notave 1: ${mes1.toStringAsFixed(2)}"); // 7.88
  print("Mesatarja e notave 2: ${mes2.toStringAsFixed(2)}"); // 0.00
  print("Mesatarja e notave 3: ${mes3.toStringAsFixed(2)}"); // 8.47
}

