import 'package:flutter/material.dart';

void main() => runApp(const SimpleButtonApp());

class SimpleButtonApp extends StatelessWidget {
  const SimpleButtonApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      home: Scaffold(
        appBar: AppBar(
          title: const Text('Buton i Thjeshtë'),
          backgroundColor: Colors.blue,
        ),
        body: const Center(
          child: ButtonWidget(),
        ),
      ),
    );
  }
}

class ButtonWidget extends StatefulWidget {
  const ButtonWidget({super.key});

  @override
  State<ButtonWidget> createState() => _ButtonWidgetState();
}

class _ButtonWidgetState extends State<ButtonWidget> {
  String _teksti = 'Përshëndetje!';
  int _klikime = 0;

  void _ndryshoGjendjen() {
    setState(() {
      _klikime++;
      if (_teksti == 'Përshëndetje!') {
        _teksti = 'U përditësua!';
      } else {
        _teksti = 'Përshëndetje!';
      }
    });

    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text('U klikua butoni! Total: $_klikime'),
        duration: const Duration(seconds: 1),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Column(
      mainAxisAlignment: MainAxisAlignment.center,
      children: [
        Text(
          _teksti,
          style: const TextStyle(fontSize: 28, fontWeight: FontWeight.bold),
        ),
        const SizedBox(height: 20),
        Text(
          'Klikime: $_klikime',
          style: const TextStyle(fontSize: 18, color: Colors.grey),
        ),
        const SizedBox(height: 30),
        ElevatedButton(
          onPressed: _ndryshoGjendjen,
          child: const Text('KLICKO MUA'),
        ),
      ],
    );
  }
}

