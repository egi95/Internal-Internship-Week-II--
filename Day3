import 'package:flutter/material.dart';

void main() {
  runApp(MyApp());
}

class MyApp extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'Task 1 - Buton që ndryshon tekstin',
      debugShowCheckedModeBanner: false,
      home: TextChangerScreen(),
    );
  }
}

class TextChangerScreen extends StatefulWidget {
  @override
  _TextChangerScreenState createState() => _TextChangerScreenState();
}

class _TextChangerScreenState extends State<TextChangerScreen> {
  String text = "Përshëndetje";

  void _changeText() {
    setState(() {
      text = (text == "Përshëndetje") ? "U përditësua!" : "Përshëndetje";
    });

    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(content: Text("Teksti u përditësua!")),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: Text('Ndrysho tekstin'),
        centerTitle: true,
      ),
      body: Center(
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            Text(
              text,
              style: TextStyle(fontSize: 28),
            ),
            SizedBox(height: 20),
            ElevatedButton(
              onPressed: _changeText,
              child: Text("Ndrysho tekstin"),
            ),
          ],
        ),
      ),
    );
  }
}

