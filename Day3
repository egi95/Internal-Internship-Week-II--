import 'package:flutter/material.dart';

void main() {
  runApp(const MyApp());
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'Lista e Artikujve',
      theme: ThemeData(
        primarySwatch: Colors.blue,
        useMaterial3: true,
      ),
      home: const ShoppingListScreen(),
      debugShowCheckedModeBanner: false,
    );
  }
}

class ShoppingListScreen extends StatefulWidget {
  const ShoppingListScreen({super.key});

  @override
  State<ShoppingListScreen> createState() => _ShoppingListScreenState();
}

class _ShoppingListScreenState extends State<ShoppingListScreen> {
  final List<String> _artikuj = [];
  final TextEditingController _controller = TextEditingController();
  final FocusNode _focusNode = FocusNode();

  void _shtoArtikull() {
    final text = _controller.text.trim();
    
    if (text.isEmpty) {
      // Shfaq SnackBar për input bosh
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('Ju lutem shkruani një artikull!'),
          duration: Duration(seconds: 2),
          backgroundColor: Colors.red,
        ),
      );
      return;
    }

    if (_artikuj.contains(text)) {
      // Shfaq SnackBar për artikull të dyfishuar
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('"$text" ekziston tashmë në listë!'),
          duration: const Duration(seconds: 2),
          backgroundColor: Colors.orange,
        ),
      );
      return;
    }

    setState(() {
      _artikuj.add(text);
      _controller.clear();
    });

    // Fokusohu përsëri në TextField
    _focusNode.requestFocus();

    // Shfaq SnackBar për shtim të suksesshëm
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text('U shtua: "$text"'),
        duration: const Duration(seconds: 2),
        backgroundColor: Colors.green,
      ),
    );
  }

  void _fshijArtikull(int index) {
    final artikulliUFshire = _artikuj[index];
    
    setState(() {
      _artikuj.removeAt(index);
    });

    // Shfaq SnackBar për fshirje
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text('U fshi: "$artikulliUFshire"'),
        duration: const Duration(seconds: 3),
        backgroundColor: Colors.red,
        action: SnackBarAction(
          label: 'ZHBLLOKO',
          textColor: Colors.white,
          onPressed: () {
            _zhabllokoFshirje(artikulliUFshire, index);
          },
        ),
      ),
    );
  }

  void _zhabllokoFshirje(String artikulli, int indexOrigjinal) {
    setState(() {
      // Shto artikullin përsëri në pozicionin origjinal
      _artikuj.insert(indexOrigjinal, artikulli);
    });

    // Shfaq SnackBar për zhbllokim
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text('U zhbllokua: "$artikulli"'),
        duration: const Duration(seconds: 2),
        backgroundColor: Colors.green,
      ),
    );
  }

  void _fshiTeGjitha() {
    if (_artikuj.isEmpty) return;

    setState(() {
      _artikuj.clear();
    });

    ScaffoldMessenger.of(context).showSnackBar(
      const SnackBar(
        content: Text('Të gjitha artikujt u fshinë!'),
        duration: Duration(seconds: 2),
        backgroundColor: Colors.red,
      ),
    );
  }

  void _shtoArtikujTest() {
    final artikujTest = ['Qumësht', 'Buka', 'Veze'];
    
    setState(() {
      _artikuj.addAll(artikujTest);
    });

    ScaffoldMessenger.of(context).showSnackBar(
      const SnackBar(
        content: Text('U shtuan 3 artikuj test!'),
        duration: Duration(seconds: 2),
        backgroundColor: Colors.blue,
      ),
    );
  }

  @override
  void dispose() {
    _controller.dispose();
    _focusNode.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Lista e Artikujve'),
        backgroundColor: Colors.blue,
        foregroundColor: Colors.white,
        actions: [
          if (_artikuj.isNotEmpty)
            IconButton(
              icon: const Icon(Icons.delete_sweep),
              onPressed: _fshiTeGjitha,
              tooltip: 'Fshi të gjitha',
            ),
          IconButton(
            icon: const Icon(Icons.add_box),
            onPressed: _shtoArtikujTest,
            tooltip: 'Shto artikuj test',
          ),
        ],
      ),
      body: Column(
        children: [
          // Seksioni i shtimit
          Container(
            padding: const EdgeInsets.all(16),
            decoration: BoxDecoration(
              color: Colors.grey[50],
              border: Border.bottom: BorderSide(color: Colors.grey[300]!),
            ),
            child: Row(
              children: [
                Expanded(
                  child: TextField(
                    controller: _controller,
                    focusNode: _focusNode,
                    decoration: const InputDecoration(
                      hintText: 'Shkruani një artikull...',
                      border: OutlineInputBorder(),
                      contentPadding: EdgeInsets.symmetric(horizontal: 16),
                    ),
                    onSubmitted: (_) => _shtoArtikull(),
                  ),
                ),
                const SizedBox(width: 12),
                ElevatedButton(
                  onPressed: _shtoArtikull,
                  style: ElevatedButton.styleFrom(
                    backgroundColor: Colors.blue,
                    foregroundColor: Colors.white,
                    padding: const EdgeInsets.symmetric(horizontal: 24, vertical: 16),
                  ),
                  child: const Row(
                    mainAxisSize: MainAxisSize.min,
                    children: [
                      Icon(Icons.add),
                      SizedBox(width: 8),
                      Text('Shto'),
                    ],
                  ),
                ),
              ],
            ),
          ),

          // Informacion për listën
          if (_artikuj.isEmpty)
            const Expanded(
              child: Center(
                child: Column(
                  mainAxisAlignment: MainAxisAlignment.center,
                  children: [
                    Icon(
                      Icons.list_alt,
                      size: 64,
                      color: Colors.grey,
                    ),
                    SizedBox(height: 16),
                    Text(
                      'Lista është bosh',
                      style: TextStyle(
                        fontSize: 18,
                        color: Colors.grey,
                      ),
                    ),
                    SizedBox(height: 8),
                    Text(
                      'Shtoni artikuj duke shkruar më lart',
                      style: TextStyle(color: Colors.grey),
                    ),
                  ],
                ),
              ),
            )
          else
            // Lista e artikujve
            Expanded(
              child: Column(
                children: [
                  // Header i listës
                  Container(
                    padding: const EdgeInsets.all(16),
                    color: Colors.blue[50],
                    child: Row(
                      mainAxisAlignment: MainAxisAlignment.spaceBetween,
                      children: [
                        Text(
                          'Artikujt (${_artikuj.length})',
                          style: const TextStyle(
                            fontWeight: FontWeight.bold,
                            color: Colors.blue,
                          ),
                        ),
                        Text(
                          'Total: ${_artikuj.length}',
                          style: const TextStyle(
                            color: Colors.blue,
                          ),
                        ),
                      ],
                    ),
                  ),

                  // Lista
                  Expanded(
                    child: ListView.builder(
                      itemCount: _artikuj.length,
                      itemBuilder: (context, index) {
                        final artikulli = _artikuj[index];
                        return Container(
                          margin: const EdgeInsets.symmetric(horizontal: 12, vertical: 4),
                          decoration: BoxDecoration(
                            color: Colors.white,
                            borderRadius: BorderRadius.circular(8),
                            boxShadow: [
                              BoxShadow(
                                color: Colors.grey.withOpacity(0.2),
                                blurRadius: 2,
                                offset: const Offset(0, 1),
                              ),
                            ],
                          ),
                          child: ListTile(
                            leading: CircleAvatar(
                              backgroundColor: Colors.blue[100],
                              child: Text(
                                '${index + 1}',
                                style: const TextStyle(
                                  fontWeight: FontWeight.bold,
                                  color: Colors.blue,
                                ),
                              ),
                            ),
                            title: Text(
                              artikulli,
                              style: const TextStyle(fontSize: 16),
                            ),
                            trailing: IconButton(
                              icon: const Icon(
                                Icons.delete,
                                color: Colors.red,
                              ),
                              onPressed: () => _fshijArtikull(index),
                              tooltip: 'Fshi artikullin',
                            ),
                            onTap: () {
                              // Mund të shtohet editim me tap të dyfishtë
                              ScaffoldMessenger.of(context).showSnackBar(
                                SnackBar(
                                  content: Text('Klikuar: $artikulli'),
                                  duration: const Duration(seconds: 1),
                                ),
                              );
                            },
                          ),
                        );
                      },
                    ),
                  ),
                ],
              ),
            ),
        ],
      ),

      // Floating Action Button për shtim të shpejtë
      floatingActionButton: _artikuj.length >= 3
          ? FloatingActionButton(
              onPressed: () {
                ScaffoldMessenger.of(context).showSnackBar(
                  SnackBar(
                    content: Text('Keni ${_artikuj.length} artikuj në listë!'),
                    duration: const Duration(seconds: 2),
                  ),
                );
              },
              backgroundColor: Colors.blue,
              foregroundColor: Colors.white,
              child: Badge(
                label: Text(_artikuj.length.toString()),
                child: const Icon(Icons.shopping_cart),
              ),
            )
          : null,
    );
  }
}
