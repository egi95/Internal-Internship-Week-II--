

class Product {
  int id;
  String name;
  double price;

  Product(this.id, this.name, this.price);
}

class Store {
  List<Product> store = [];

  
  void addProduct(Product p) {
    store.add(p);
  }

  
  bool removeById(int id) {
    return store.removeWhere((p) => p.id == id) > 0;
  }

 
  List<Product> inPriceRange(double min, double max) {
    return store.where((p) => p.price >= min && p.price <= max).toList();
  }
}

void main() {
  // Krijojmë një objekt të Store
  Store shop = Store();

 
  shop.addProduct(Product(1, "Bukë", 10.0));
  shop.addProduct(Product(2, "Qumësht", 15.5));
  shop.addProduct(Product(3, "Ujë", 5.0));
  shop.addProduct(Product(4, "Vaj ulliri", 25.0));

  
  bool uFshi = shop.removeById(2);
  print(uFshi ? "Produkti me ID 2 u fshi me sukses." : "Produkti me ID 2 nuk u gjet.");

  
  List<Product> rezultat = shop.inPriceRange(10.0, 25.0);

  
  print("\nProdukte në intervalin 10.0 – 25.0:");
  for (var p in rezultat) {
    print("#${p.id} ${p.name} - ${p.price.toStringAsFixed(2)}");
  }
}
