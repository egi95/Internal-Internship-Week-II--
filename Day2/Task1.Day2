class Student {
  String emri;
  List<double> nota;

  // Konstruktor
  Student(this.emri, this.nota);

  // Metoda që llogarit mesataren e notave
  double mesatarja() {
    if (nota.isEmpty) {
      return 0.0;
    }
    double total = 0.0;
    for (double n in nota) {
      total += n;
    }
    return total / nota.length;
  }
}

void main() {
  // Krijojmë disa studentë
  List<Student> studentet = [
    Student("Ana", [8, 9, 10]),
    Student("Ardit", [6, 7, 8]),
    Student("Besa", []), // lista bosh për testim
  ];

  // Gjejmë studentin me mesataren më të lartë
  Student topStudent = studentet[0];
  for (Student s in studentet) {
    if (s.mesatarja() > topStudent.mesatarja()) {
      topStudent = s;
    }
  }

  // Printojmë rezultatin
  print("Top: ${topStudent.emri} - ${topStudent.mesatarja().toStringAsFixed(2)}");
}

Output
  Top: Ana - 9.00
