class Student {
  String emri;
  List<double> nota;

  // Konstruktori
  Student(this.emri, this.nota);

  // Metoda për llogaritjen e mesatares
  double mesatarja() {
    if (nota.isEmpty) {
      return 0.0;
    }
    
    double shuma = 0.0;
    for (double note in nota) {
      shuma += note;
    }
    return shuma / nota.length;
  }

  // Metodë për paraqitje të lexueshme
  @override
  String toString() {
    return '$emri${nota} - Mesatarja: ${mesatarja().toStringAsFixed(2)}';
  }
}

void main() {
  // Krijimi i listës së studentëve
  List<Student> studentet = [
    Student('Ana', [8, 9, 10]),
    Student('Ardit', [6, 7, 8]),
    Student('Blerina', [9, 9.5, 10, 8.5]),
    Student('Dritan', []), // Student me lista bosh
    Student('Elona', [7, 8.5, 9, 8, 7.5]),
  ];

  // Printimi i të gjithë studentëve
  print('Lista e të gjithë studentëve:');
  for (Student student in studentet) {
    print(student);
  }
  print(''); // Linjë bosh për ndarje

  // Gjetja e studentit me mesataren më të lartë
  Student? topStudent;
  double mesatarjaMax = -1.0;

  for (Student student in studentet) {
    double mesatarjaAktuale = student.mesatarja();
    if (mesatarjaAktuale > mesatarjaMax) {
      mesatarjaMax = mesatarjaAktuale;
      topStudent = student;
    }
  }

  // Printimi i rezultatit
  if (topStudent != null) {
    print('Top: ${topStudent.emri} - ${topStudent.mesatarja().toStringAsFixed(2)}');
  } else {
    print('Nuk ka studentë në listë');
  }

  // Testim shtesë - vetëm me studentë me lista bosh
  print('\n--- Testim me lista të zbrazëta ---');
  List<Student> studentetBosh = [
    Student('Fatos', []),
    Student('Genta', []),
  ];

  Student? topBosh;
  double maxBosh = -1.0;
  
  for (Student student in studentetBosh) {
    double mesatarjaAktuale = student.mesatarja();
    if (mesatarjaAktuale > maxBosh) {
      maxBosh = mesatarjaAktuale;
      topBosh = student;
    }
  }

  if (topBosh != null) {
    print('Top (lista bosh): ${topBosh.emri} - ${topBosh.mesatarja().toStringAsFixed(2)}');
  }
}

