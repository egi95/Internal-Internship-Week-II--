// Program për të llogaritur mesataren e notave në Dart

double mesatarja(List<double> nota) {
  // Nëse lista është bosh, kthe 0.0
  if (nota.isEmpty) {
    return 0.0;
  }

  // Llogarit shumën e të gjitha notave
  double total = 0;
  for (double n in nota) {
    total += n;
  }

  // Kthe mesataren
  return total / nota.length;
}

void main() {
  // Shembull inputi
  List<double> notat = [7, 8.5, 10, 6];

  // Thirr funksionin
  double rezultat = mesatarja(notat);

  // Printo me 2 shifra pas presjes
  print(rezultat.toStringAsFixed(2));

  // Mund ta testosh edhe me listë bosh
  List<double> bosh = [];
  print(mesatarja(bosh).toStringAsFixed(2));
}
